# Ambiente local não exige gateway. Em ambientes publicados, configure APP_ENV e GATEWAY_TOKEN.
APP_ENV=local
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# Configuração ÚNICA da Bridge, usada por BJN, Auditoria, Chatbot e Behavior.
# Copie este modelo para .env (não versionado) ou injete via gestor de segredos.
# NÃO configure as mesmas credenciais nos prompts, código Python ou Angular.
BRADESCO_AMBIENTE=dev
# Deployment padrão do text_generator (distinto do agente Q&A).
# Se estiver ausente ou vazio, o backend utiliza gpt-5.1.
BRADESCO_TEXT_MODEL=gpt-5.1
BRADESCO_IDENTIFICADOR=
BRADESCO_SENHA=
BRADESCO_AUTHORIZATION_TOKEN=
BRADESCO_CA_BUNDLE=
BRADESCO_TIMEOUT_SECONDS=600

# Opcionais: somente se a infraestrutura corporativa exigir URLs explícitas.
BRADESCO_TEXT_URL=
BRADESCO_IDENTITY_URL=
BRADESCO_QA_URL=
# Agente corporativo de perguntas e respostas, configurado em um único local.
BRADESCO_QA_WORKFLOW_CODE=

# Limites do workspace documental.
MAX_UPLOAD_BYTES=26214400
MAX_UPLOAD_FILES=12
MAX_TOTAL_UPLOAD_BYTES=83886080
MAX_PDF_PAGES=2500
WORKSPACE_TTL_MINUTES=120
MAX_WORKSPACES_IN_MEMORY=30
BRADESCO_PROMPT_MAX_CHARS=52000
BRADESCO_ANALYSIS_MAX_TOKENS=9000
MAX_ANALYSIS_CHUNKS=24

# Demandas BJN: persistência privada e diretório de anexos.
# Em produção, usar volume persistente cifrado e autenticação do gateway corporativo.
BJN_DATABASE_PATH=.runtime/bjn/demandas.sqlite3
BJN_UPLOAD_DIRECTORY=.runtime/bjn/uploads
# Lista permitida de advogados (e-mails corporativos), separada por vírgula.
BJN_ALLOWED_LAWYERS=

# Somente APP_ENV=local: habilita equipe fictícia de advogados na distribuição BJN.
BJN_DEMO_LAWYERS=true

# BJN · fluxo de demandas (não inserir credenciais neste arquivo exemplo)
# Em ambiente local a chave HMAC é criada automaticamente em .runtime/bjn.
BJN_DOCUMENT_HASH_KEY=
# Notificações por e-mail são opcionais; em branco mantém o envio pendente.
BJN_NOTIFICATION_SMTP_HOST=
BJN_NOTIFICATION_SMTP_PORT=587
BJN_NOTIFICATION_SENDER=
BJN_NOTIFICATION_USERNAME=
BJN_NOTIFICATION_PASSWORD=

# Catálogos corporativos para o BJN (UTF-8, não inclua informações pessoais).
# Quando vazios, são usados os modelos em data/cadastros/.
# Departamentos: coluna departamento (NNNN - Nome); opção alternativa codigo,nome.
# Agências: duas colunas numero_agencia,nome_agencia (4 dígitos no número).
BJN_DEPARTMENTS_CSV=
BJN_AGENCIES_CSV=

# Behavior: parâmetros técnicos sem credenciais adicionais.
BEHAVIORAL_LAB_DATABASE_PATH=.runtime/behavioral_lab/laboratorio.sqlite3
# Modo demonstração somente quando APP_ENV=local; simulações não representam pessoas reais.
BEHAVIORAL_LAB_DEMO_ENABLED=true
BEHAVIORAL_LAB_MAX_CALLS=120
